-- 8. ป้องกันการล้ม / สตัน (Anti-Ragdoll)
RunService.Heartbeat:Connect(function()
    if Config.AntiRagdoll then
        local char = getChar(LocalPlayer)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
