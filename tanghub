-- ฟังก์ชั่นตัวช่วยทั่วไป
local function getChar(plr)
    plr = plr or LocalPlayer
    return plr.Character
end

local function getRoot(plr)
    local char = getChar(plr)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
end

local function getSuitModelValue()
    local char = getChar(LocalPlayer)
    if char and char:FindFirstChild("Suit") and char.Suit:FindFirstChild("SuitStatus") then
        local mv = char.Suit.SuitStatus:FindFirstChild("ModelValue")
        if mv then return mv.Value end
    end
    return "Mark85"
end

local function getNearestTarget()
    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return nil end
    local nearestDist = Config.KillAuraRange
    local nearestChar = nil
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character:FindFirstChild(Config.KillAuraTargetPart) or plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearestChar = plr.Character
                end
            end
        end
    end
    return nearestChar
end

-- 1. ฟังก์ชั่นสังหารเป้าหมาย (Kill Target)
local function attackTarget(targetChar, times)
    times = times or 1
    if not targetChar or not DamageEvent then return end
    local myChar = getChar(LocalPlayer)
    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return end
    
    local targetPart = targetChar:FindFirstChild(Config.KillAuraTargetPart) or targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Head")
    if not targetPart then return end
    
    local myHead = myChar and myChar:FindFirstChild("Head") or myRoot
    local origin = myHead.Position
    local dir = (targetPart.Position - origin).Unit
    
    for i = 1, times do
        pcall(function()
            DamageEvent:FireServer(targetChar, targetPart, nil, origin, dir)
        end)
    end
end

-- ลูป Kill Aura
task.spawn(function()
    while true do
        if Config.KillAura or Config.SpawnKillLoop then
            local myRoot = getRoot(LocalPlayer)
            if myRoot then
                if Config.KillAuraNearestOnly then
                    local target = getNearestTarget()
                    if target then
                        attackTarget(target, 2)
                    end
                else
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                            local root = plr.Character:FindFirstChild("HumanoidRootPart")
                            if hum and hum.Health > 0 and root then
                                local dist = (root.Position - myRoot.Position).Magnitude
                                if dist <= Config.KillAuraRange then
                                    attackTarget(plr.Character, Config.SpawnKillLoop and 4 or 1)
                                end
                            end
                        end
                    end
                end
            end
            task.wait(Config.KillAuraDelay)
        else
            task.wait(0.4)
        end
    end
end)

-- 2. กวาดล้างทั้งแมพใน 1 คลิก (One-Shot Wipe All)
local function killAllOnce()
    if not DamageEvent then return end
    local myChar = getChar(LocalPlayer)
    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return end
    local myHead = myChar:FindFirstChild("Head") or myRoot
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local dir = (root.Position - myHead.Position).Unit
                for i = 1, 8 do
                    pcall(function()
                        DamageEvent:FireServer(plr.Character, root, nil, myHead.Position, dir)
                    end)
                end
            end
        end
    end
end

-- 3. ลูปสแปมสกิลไร้คูลดาวน์ (No Cooldown Loops)
task.spawn(function()
    while true do
        local ran = false
        
        -- สแปมสกิล 1 (โล่/พลังพิเศษ)
        if Config.SpamAbility1 and AbilityEvent then
            ran = true
            pcall(function()
                AbilityEvent:FireServer(1, true, nil)
            end)
        end
        
        -- สแปมสกิล 2 (มีดดาบ/หายตัว/EMP)
        if Config.SpamAbility2 and AbilityEvent then
            ran = true
            pcall(function()
                AbilityEvent:FireServer(2, true, nil)
            end)
        end
        
        -- สแปมมิสไซล์
        if Config.SpamMissiles and CombatEvent then
            ran = true
            local suitVal = getSuitModelValue()
            pcall(function()
                CombatEvent:FireServer("WristMissiles", nil, nil, nil, suitVal)
            end)
        end
        
        -- สแปม Ex-Wife หัวรบยักษ์
        if Config.SpamExWife and CombatEvent then
            ran = true
            local target = getNearestTarget()
            local myRoot = getRoot(LocalPlayer)
            local hitPos = target and getRoot(Players:GetPlayerFromCharacter(target)) and getRoot(Players:GetPlayerFromCharacter(target)).Position or (Camera.CFrame.Position + Camera.CFrame.LookVector * 150)
            local dir = (hitPos - (myRoot and myRoot.Position or Vector3.zero)).Unit
            local suitVal = getSuitModelValue()
            pcall(function()
                CombatEvent:FireServer("ExWife", "nil", hitPos, dir, suitVal)
            end)
        end
        
        -- สแปมหมัดปืนกลรีพัลเซอร์
        if Config.SpamRepulsor and CombatEvent then
            ran = true
            local target = getNearestTarget()
            local myRoot = getRoot(LocalPlayer)
            local hitPos = target and getRoot(Players:GetPlayerFromCharacter(target)) and getRoot(Players:GetPlayerFromCharacter(target)).Position or (Camera.CFrame.Position + Camera.CFrame.LookVector * 120)
            local suitVal = getSuitModelValue()
            pcall(function()
                CombatEvent:FireServer("Repulsor", "Right", hitPos, nil, suitVal)
                CombatEvent:FireServer("Repulsor", "Left", hitPos, nil, suitVal)
            end)
        end
        
        -- สแปมพลุความร้อน
        if Config.SpamFlares and FlaresEvent then
            ran = true
            pcall(function()
                FlaresEvent:FireServer()
            end)
        end
        
        if ran then
            task.wait(0.08)
        else
            task.wait(0.3)
        end
    end
end)

-- 4. บายพาสคูลดาวน์ภายในเฟรมเวิร์กตัวละคร (Bypass Framework Debounces)
RunService.Heartbeat:Connect(function()
    if Config.NoCooldown then
        local char = getChar(LocalPlayer)
        if char then
            for _, scr in ipairs(char:GetChildren()) do
                if scr:IsA("LocalScript") and string.find(scr.Name, "Ironman") then
                    pcall(function()
                        if getsenv then
                            local env = getsenv(scr)
                            if env.AbilityCooldown ~= nil then env.AbilityCooldown = false end
                            if env.UsingAbility ~= nil then env.UsingAbility = false end
                            if env.laserDebounce ~= nil then env.laserDebounce = false end
                            if env.punchDebounce ~= nil then env.punchDebounce = false end
                            if env.ejectDebounce ~= nil then env.ejectDebounce = false end
                        end
                    end)
                end
            end
        end
    end
end)

-- 5. ลูปการเคลื่อนที่, บินเร็วแสง & กระโดดสูง
RunService.Heartbeat:Connect(function()
    local char = getChar(LocalPlayer)
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if Config.SpeedHack and hum.WalkSpeed ~= Config.WalkSpeed then
                hum.WalkSpeed = Config.WalkSpeed
            end
            if hum.JumpPower ~= Config.JumpPower then
                hum.JumpPower = Config.JumpPower
            end
            -- ล็อกเลือดอมตะ (Godmode)
            if Config.GodmodeLock and hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
        
        -- บูสต์ความเร็วการบินทะลุมิติ
        if Config.FlightBoost then
            local bv = char:FindFirstChild("BodyVelocity") or (char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart:FindFirstChild("BodyVelocity"))
            if bv and bv.Velocity.Magnitude > 5 then
                bv.Velocity = bv.Velocity.Unit * (bv.Velocity.Magnitude * Config.FlightMultiplier)
            end
        end
    end
end)

