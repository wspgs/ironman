end)

-- 9. ระบบมองทะลุผู้เล่น (ESP ภาษาไทย)
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "TangHub_Thai_ESP"
pcall(function() ESPFolder.Parent = CoreGui end)
if not ESPFolder.Parent then ESPFolder.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local function updateESP(plr)
    if plr == LocalPlayer then return end
    local highlight = ESPFolder:FindFirstChild("HL_" .. plr.Name)
    local tag = ESPFolder:FindFirstChild("Tag_" .. plr.Name)
    
    if not Config.ESP then
        if highlight then highlight:Destroy() end
        if tag then tag:Destroy() end
        return
    end
    
    local char = plr.Character
    local root = getRoot(plr)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if char and root and hum and hum.Health > 0 then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "HL_" .. plr.Name
            highlight.FillColor = Config.ESPColor
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0.1
            highlight.Parent = ESPFolder
        end
        highlight.Adornee = char
        highlight.FillColor = Config.ESPColor
        
        if not tag then
            tag = Instance.new("BillboardGui")
            tag.Name = "Tag_" .. plr.Name
            tag.Size = UDim2.new(0, 160, 0, 48)
            tag.AlwaysOnTop = true
            tag.StudsOffset = Vector3.new(0, 3.2, 0)
            tag.Parent = ESPFolder
            
            local lbl = Instance.new("TextLabel")
            lbl.Name = "Info"
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            lbl.TextStrokeTransparency = 0
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 12
            lbl.Parent = tag
        end
        tag.Adornee = root
        
        local suitName = "ไม่มีชุด"
        if char:FindFirstChild("Suit") then
            suitName = char.Suit.Name
        end
        local myRoot = getRoot(LocalPlayer)
        local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0
        tag.Info.Text = string.format("👤 %s | เลือด: %d\n🛡️ [%s] 📍 %d เมตร", plr.DisplayName, math.floor(hum.Health), suitName, dist)
    else
        if highlight then highlight:Destroy() end
        if tag then tag:Destroy() end
    end
end

RunService.RenderStepped:Connect(function()
    if Config.ESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            updateESP(plr)
